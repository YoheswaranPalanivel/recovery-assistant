# ---------- Server ----------
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Sign-in ----------
# Two roles: admin (upload, load, clear data) and analyst (view, write insights).
# Change these before showing the app to anyone.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=Analyst@12345
# Signs session tokens. Any long random string. Without it, everyone is logged out on restart.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8

# Machine key for the streaming endpoint (/api/ingest), used by `npm run replay`.
INGEST_API_KEY=change-me-ingest-key

# Key used to pseudonymise dataset user ids. Keep it stable, or the same person
# becomes a new pseudonym. If empty, one is generated in data/.pseudonym-secret.
PSEUDONYM_SECRET=

# Keep a snapshot in data/store.json so restarts don't empty the dashboard.
PERSIST_DATA=true

# ---------- LLM (optional; without it the app uses template messages) ----------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2000
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-oss-120b
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=gpt-oss:20b
# Claude instead:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- Analytics ----------
TARGET_STEPS=8000
MAX_UPLOAD_MB=50
